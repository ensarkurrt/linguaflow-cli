{
  "name": "@linguaflow/cli",
  "version": "0.1.0",
  "description": "LinguaFlow çevirilerini senkronize eden, doğrulayan ve yayınlayan CLI.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/main.cjs",
    "dist/api.js",
    "dist/cli.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "linguaflow": "dist/main.cjs"
  },
  "exports": {
    "./api": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/api.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ensarkurrt/linguaflow-cli.git"
  },
  "homepage": "https://github.com/ensarkurrt/linguaflow-cli#readme",
  "bugs": "https://github.com/ensarkurrt/linguaflow-cli/issues",
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean-package-output.mjs",
    "build": "pnpm clean && tsc -p tsconfig.json && esbuild src/main.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/main.cjs && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/api.js",
    "test": "pnpm build && node --test test/*.test.js",
    "prepack": "pnpm build",
    "pack:check": "pnpm pack --pack-destination .artifacts && node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@linguaflow/core": "^0.1.0",
    "@linguaflow/management-sdk": "^0.1.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.27.0",
    "typescript": "^6.0.2",
    "zod": "^4.1.5"
  },
  "engines": {
    "node": ">=22.14"
  },
  "private": false,
  "packageManager": "pnpm@10.17.1"
}
